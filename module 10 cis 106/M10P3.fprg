<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="AutoOutTheDoorCalculator"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value="Computes out-the-door price for vehicles and sums total MSRPs and total sales prices."/>
        <attribute name="saved" value="2026-11-11 09:22:46 PM"/>
        <attribute name="created" value="2026-11-11 09:20:00 PM"/>
        <attribute name="edited" value="2026-11-11 09:20:00 PM"/>
        <attribute name="edited" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTEtMTE7MDk6MjI6NDYgUE07MTszMDQw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="response" type="String" array="False" size=""/>
            <declare name="make" type="String" array="False" size=""/>
            <declare name="model" type="String" array="False" size=""/>
            <declare name="evCode" type="String" array="False" size=""/>
            <declare name="msrp" type="Real" array="False" size=""/>
            <declare name="outTheDoor" type="Real" array="False" size=""/>
            <declare name="totalMSRP" type="Real" array="False" size=""/>
            <declare name="totalSalesPrice" type="Real" array="False" size=""/>
            <assign variable="totalMSRP" expression="0.0"/>
            <assign variable="totalSalesPrice" expression="0.0"/>
            <output expression="&quot;Do you want to run the program? (Yes or No)&quot;" newline="True"/>
            <input variable="response"/>
            <while expression="response == &quot;Yes&quot; || response == &quot;yes&quot; || response == &quot;YES&quot; || response == &quot;Y&quot; || response == &quot;y&quot;">
                <output expression="&quot;Enter vehicle make:&quot;" newline="True"/>
                <input variable="make"/>
                <output expression="&quot;Enter vehicle model:&quot;" newline="True"/>
                <input variable="model"/>
                <output expression="&quot;Is this an electric vehicle? (Y or N):&quot;" newline="True"/>
                <input variable="evCode"/>
                <output expression="&quot;Enter MSRP (sticker price):&quot;" newline="True"/>
                <input variable="msrp"/>
                <assign variable="outTheDoor" expression="computeOutTheDoor(msrp, make, model, evCode)"/>
                <assign variable="totalMSRP" expression="totalMSRP + msrp"/>
                <assign variable="totalSalesPrice" expression="totalSalesPrice + outTheDoor"/>
                <output expression="&quot;Out the door price: $&quot; &amp; ToFixed(outTheDoor, 2)" newline="True"/>
                <output expression="&quot;Do you want to enter another vehicle? (Yes or No)&quot;" newline="True"/>
                <input variable="response"/>
            </while>
            <output expression="&quot;Total of all MSRPs: $&quot; &amp; ToFixed(totalMSRP, 2)" newline="True"/>
            <output expression="&quot;Total of all Sales Prices: $&quot; &amp; ToFixed(totalSalesPrice, 2)" newline="True"/>
        </body>
    </function>
    <function name="computeOutTheDoor" type="Real" variable="totalPrice">
        <parameters>
            <parameter name="msrp" type="Real" array="False"/>
            <parameter name="make" type="String" array="False"/>
            <parameter name="model" type="String" array="False"/>
            <parameter name="evCode" type="String" array="False"/>
        </parameters>
        <body>
            <declare name="discountPct" type="Real" array="False" size=""/>
            <declare name="newMSRP" type="Real" array="False" size=""/>
            <declare name="totalPrice" type="Real" array="False" size=""/>
            <if expression="evCode == &quot;Y&quot; || evCode == &quot;y&quot; || evCode == &quot;Yes&quot; || evCode == &quot;yes&quot;">
                <then>
                    <assign variable="discountPct" expression="0.30"/>
                </then>
                <else>
                    <if expression="(make == &quot;Honda&quot; || make == &quot;honda&quot;) &amp;&amp; (model == &quot;Accord&quot; || model == &quot;accord&quot;)">
                        <then>
                            <assign variable="discountPct" expression="0.10"/>
                        </then>
                        <else>
                            <if expression="(make == &quot;Toyota&quot; || make == &quot;toyota&quot;) &amp;&amp; (model == &quot;Rav4&quot; || model == &quot;rav4&quot; || model == &quot;RAV4&quot;)">
                                <then>
                                    <assign variable="discountPct" expression="0.15"/>
                                </then>
                                <else>
                                    <assign variable="discountPct" expression="0.05"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="newMSRP" expression="msrp * (1 - discountPct)"/>
            <assign variable="totalPrice" expression="newMSRP * 1.07"/>
        </body>
    </function>
</flowgorithm>
